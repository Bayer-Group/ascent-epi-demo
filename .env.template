# Copy to .env and set one LLM key. Everything else has a working default.
#
#     cp .env.template .env
#     docker compose up
#
# The stack ships its own data, database and vector index. No hosted warehouse
# is needed, but an external LLM API key is required. See README.md for
# prerequisites and setup.

# --- set GEMINI_API_KEY ---------------------------------------------------
# Gemini is what the demo is built around, and the only key that gives you the
# whole thing: the chat UI's default agent is a Gemini model, and the non-OMOP
# question -> SQL pipeline asks for Gemini models by name. The other providers
# below serve the OMOP path, which substitutes whichever provider is
# configured; set one of them alone and the stack starts, but the chat UI has
# no working model and non-OMOP questions fail.
GEMINI_API_KEY=

# Azure OpenAI needs the endpoint too — the client is AzureOpenAI, so a key
# alone is not enough:
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://<your-resource>.openai.azure.com/
#
# These configure the backend's Azure clients. Some clients name a specific
# deployment (OPENAI_EAST_US_2_BASE / OPENAI_EAST_US_2_KEY); unset, those fall
# back to OPENAI_API_BASE / OPENAI_API_KEY. Extra settings need an explicit
# Compose environment mapping when running in containers. The medical-coder
# uses different Azure settings; see services/medical-coder/README.md.

# Claude, either way round:
#   direct from Anthropic — one key, nothing else
# ANTHROPIC_API_KEY=
#   or through Bedrock using the SDK's default credential chain.
# See the optional credential mappings in docker-compose.yml.

# Call sites name providers directly ("gpt", "claude_sonnet"). With a single
# key configured they are substituted automatically and a warning is logged.
# Set this to choose deliberately instead:
# LLM_PROVIDER_ALIASES={"gpt":"gemini","claude_sonnet":"gemini"}

# --- data -----------------------------------------------------------------
# 1k ships in the repo. Generate 10k locally or use a maintainer-provided mirror;
# see data/synthetic/README.md (no default download URL is configured).
DATA_SCALE=1k

# --- keeping strangers out ------------------------------------------------
# Not needed to run locally: compose binds every port to 127.0.0.1, so the
# stack is only reachable from your machine.
#
# Set this before exposing the backend (a LAN, tunnel, or shared box). The main
# and experimental MCP servers then require `Authorization: Bearer <it>`.
# Health probes and the generic UI-kit server stay public. It is a shared gate,
# not individual identities. See docs/operations.md for the full checklist.
# API_AUTH_TOKEN=

# --- Chat UI ------------------------------------------------------------
# The stack creates this LibreChat account at startup so nobody has to fill in
# a sign-up form. LibreChat has no anonymous mode, so some account has to
# exist; these are the defaults documented in the README. Change them before
# running anywhere other than localhost.
# CHAT_USER=demo@ascent.local
# CHAT_PASSWORD=ascentdemo
# These seed a new account; changing them does not rotate an existing password.
# Before exposing chat, also replace ALL FOUR known default secrets. Generate
# independent values (32 random bytes for keys/secrets, 16 for CREDS_IV) and
# paste the hex strings here; .env does not execute shell substitutions.
# CREDS_KEY=
# CREDS_IV=
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# Plan rotation for existing installations: sessions/stored credentials may
# depend on the old values. See docs/operations.md.

# Host ports, if 8000 or 3080 are already taken.
# BACKEND_PORT=8000
# LIBRECHAT_PORT=3080
